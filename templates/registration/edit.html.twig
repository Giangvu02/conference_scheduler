{% extends 'base.html.twig' %}

{% block title %}Chỉnh sửa đăng ký{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0"><i class="fas fa-edit"></i> Chỉnh sửa đăng ký #{{ form.vars.value.id }}</h3>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info mb-4">
                        <strong>Ngày đăng ký ban đầu:</strong> {{ form.vars.value.registrationDate|date('d/m/Y H:i') }}
                    </div>

                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.user, 'Người dùng') }}
                            {{ form_widget(form.user, {'attr': {'class': 'form-select'}}) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.session, 'Phiên họp') }}
                            {{ form_widget(form.session, {'attr': {'class': 'form-select'}}) }}
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="{{ path('app_registration_index') }}" class="btn btn-outline-secondary">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4">Cập nhật thông tin</button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}