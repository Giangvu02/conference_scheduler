{% extends 'base.html.twig' %}
{% block title %}Chi tiết Phiên họp{% endblock %}
{% block body %}
<div class="container mt-4">
    <h2>Phiên họp: {{ session.title }}</h2>
    <table class="table table-bordered mt-3">
        <tbody>
            <tr><th style="width: 200px;">Hội nghị</th><td>{{ session.conference ? session.conference.title : '' }}</td></tr>
            <tr><th>Diễn giả</th><td>{{ session.speaker ? session.speaker.name : '' }}</td></tr>
            <tr><th>Phòng</th><td>{{ session.room ? session.room.roomName : '' }}</td></tr>
            <tr><th>Ngày diễn ra</th><td>{{ session.sessionDate ? session.sessionDate|date('d/m/Y') : '' }}</td></tr>
            <tr><th>Thời gian</th><td>{{ session.startTime ? session.startTime|date('H:i') : '' }} đến {{ session.endTime ? session.endTime|date('H:i') : '' }}</td></tr>
        </tbody>
    </table>
    <div class="mt-3">
        <a href="{{ path('app_session_index') }}" class="btn btn-secondary">Quay lại</a>
    </div>
</div>
{% endblock %}