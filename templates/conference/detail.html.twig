{% extends 'base.html.twig' %}

{% block body %}
<style>
  .detail-wrapper { max-width: 800px; margin: 40px auto; padding: 0 24px; font-family: 'Inter', sans-serif; }
  .header-section { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
  .info-grid { background: white; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
  .info-row { display: grid; grid-template-columns: 200px 1fr; border-bottom: 1px solid #f1f5f9; }
  .info-row:last-child { border-bottom: none; }
  .info-label { padding: 16px 24px; background: #f8fafc; color: #64748b; font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; }
  .info-value { padding: 16px 24px; color: #1e293b; font-size: 0.9375rem; line-height: 1.5; }
  
  .btn-group { margin-top: 24px; display: flex; gap: 12px; }
  .btn { padding: 10px 20px; border-radius: 8px; font-size: 0.875rem; font-weight: 500; text-decoration: none; }
  .btn-edit { background: #1e293b; color: white; }
  .btn-secondary { border: 1px solid #e2e8f0; color: #475569; }
</style>

<div class="detail-wrapper">
  <div class="header-section">
    <div>
      <h1 style="margin:0; font-size: 1.75rem;">{{ conference.title }}</h1>
      <p style="color:#64748b; margin:4px 0 0;">Reference ID: #{{ conference.id }}</p>
    </div>
    <div class="btn-group" style="margin-top:0">
      <a href="{{ path('app_conference_edit', {'id': conference.id}) }}" class="btn btn-edit">Edit</a>
    </div>
  </div>

  <div class="info-grid">
    <div class="info-row"><div class="info-label">Full Title</div><div class="info-value">{{ conference.title }}</div></div>
    <div class="info-row"><div class="info-label">Location</div><div class="info-value">{{ conference.location }}</div></div>
    <div class="info-row"><div class="info-label">Description</div><div class="info-value">{{ conference.description|nl2br }}</div></div>
    <div class="info-row">
      <div class="info-label">Duration</div>
      <div class="info-value">
        {{ conference.startDate|date('F d, Y') }} — {{ conference.endDate|date('F d, Y') }}
      </div>
    </div>
  </div>

  <div class="btn-group">
    <a href="{{ path('app_conference_index') }}" class="btn btn-secondary">← Back to Records</a>
  </div>
</div>
{% endblock %}