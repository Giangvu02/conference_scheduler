{% extends 'base.html.twig' %}

{% block title %}Chi tiết Hội nghị{% endblock %}

{% block body %}
<div class="container mt-4">
    <h2>Chi tiết Hội nghị: {{ conference.title }}</h2>

    <table class="table table-bordered mt-3">
        <tbody>
            <tr>
                <th style="width: 200px;">ID</th>
                <td>{{ conference.id }}</td>
            </tr>
            <tr>
                <th>Tiêu đề</th>
                <td>{{ conference.title }}</td>
            </tr>
            <tr>
                <th>Mô tả</th>
                <td>{{ conference.description|nl2br }}</td>
            </tr>
            <tr>
                <th>Địa điểm</th>
                <td>{{ conference.location }}</td>
            </tr>
            <tr>
                <th>Ngày bắt đầu</th>
                <td>{{ conference.startDate ? conference.startDate|date('d/m/Y') : '' }}</td>
            </tr>
            <tr>
                <th>Ngày kết thúc</th>
                <td>{{ conference.endDate ? conference.endDate|date('d/m/Y') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <div class="mt-3">
        <a href="{{ path('app_conference_index') }}" class="btn btn-secondary">Quay lại danh sách</a>
        <a href="{{ path('app_conference_edit', {'id': conference.id}) }}" class="btn btn-warning">Sửa</a>
        
        <form method="post" action="{{ path('app_conference_delete', {'id': conference.id}) }}" style="display: inline-block" onsubmit="return confirm('Bạn có chắc chắn muốn xóa?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ conference.id) }}">
            <button class="btn btn-danger">Xóa</button>
        </form>
    </div>
</div>
{% endblock %}