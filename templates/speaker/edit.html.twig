{% extends 'base.html.twig' %}

{% block title %}Chỉnh sửa Diễn giả{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="fas fa-user-edit me-2"></i>Chỉnh sửa Diễn giả
                    </h4>
                    <a href="{{ path('app_speaker_index') }}" class="btn btn-dark btn-sm">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
                <div class="card-body p-4">
                    
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                        
                        {# Nhóm các trường nhập liệu ngắn #}
                        {% for field in [form.name, form.email, form.topic, form.photo] %}
                            <div class="mb-3">
                                {{ form_label(field, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                {{ form_widget(field, {
                                    'attr': {
                                        'class': 'form-control ' ~ (field.vars.valid ? '' : 'is-invalid'),
                                        'placeholder': 'Nhập ' ~ field.vars.label|lower ~ '...'
                                    }
                                }) }}
                                <div class="invalid-feedback">
                                    {{ form_errors(field) }}
                                </div>
                            </div>
                        {% endfor %}

                        {# Trường tiểu sử (Textarea) #}
                        <div class="mb-3">
                            {{ form_label(form.biography, 'Tiểu sử', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.biography, {
                                'attr': {
                                    'class': 'form-control ' ~ (form.biography.vars.valid ? '' : 'is-invalid'),
                                    'rows': '4',
                                    'placeholder': 'Mô tả chi tiết về diễn giả...'
                                }
                            }) }}
                            <div class="invalid-feedback">
                                {{ form_errors(form.biography) }}
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-warning text-dark fw-bold px-4">
                                <i class="fas fa-save me-2"></i>Lưu thay đổi
                            </button>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}