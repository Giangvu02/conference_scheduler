{% extends 'base.html.twig' %}
{% block title %}Chi tiết Phòng{% endblock %}
{% block body %}
<div class="container mt-4">
    <h2>Phòng: {{ room.roomName }}</h2>
    <table class="table table-bordered mt-3">
        <tbody>
            <tr><th style="width: 200px;">ID</th><td>{{ room.id }}</td></tr>
            <tr><th>Tên phòng</th><td>{{ room.roomName }}</td></tr>
            <tr><th>Sức chứa</th><td>{{ room.capacity }} người</td></tr>
            <tr><th>Tòa nhà</th><td>{{ room.building }}</td></tr>
        </tbody>
    </table>
    <div class="mt-3">
        <a href="{{ path('app_room_index') }}" class="btn btn-secondary">Quay lại</a>
    </div>
</div>
{% endblock %}