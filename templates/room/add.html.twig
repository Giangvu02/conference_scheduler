{% extends 'base.html.twig' %}

{% block title %}Thêm Phòng mới{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white"><h2>Tạo Phòng mới</h2></div>
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_widget(form) }}
                <div class="mt-3">
                    <button class="btn btn-success">Lưu lại</button>
                    <a href="{{ path('app_room_index') }}" class="btn btn-secondary">Quay lại</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}