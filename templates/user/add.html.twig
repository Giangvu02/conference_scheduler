{% extends 'base.html.twig' %}

{% block title %}Thêm mới Người dùng{% endblock %}

{% block body %}
<div class="container mt-4">
    <h2>Thêm mới Người dùng</h2>

    <div class="card mt-3">
        <div class="card-body">
            {# form_start mở thẻ <form>, sinh CSRF token tự động #}
            {{ form_start(form) }}
            
                {# form_widget hiển thị tất cả các trường input #}
                {{ form_widget(form) }}
                
                <div class="mt-3">
                    <button class="btn btn-success" type="submit">Lưu dữ liệu</button>
                    <a href="{{ path('app_user_index') }}" class="btn btn-secondary">Hủy bỏ</a>
                </div>
                
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}