{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm border-info">
        <div class="card-header bg-info text-white"><h3>Chi tiết đơn đăng ký #{{ reg.id }}</h3></div>
        <div class="card-body">
            <table class="table table-borderless">
                <tr><th>Email người dùng:</th><td>{{ reg.user.email }}</td></tr>
                <tr><th>Phiên họp tham gia:</th><td>{{ reg.session.title }}</td></tr>
                <tr><th>Ngày đăng ký:</th><td>{{ reg.registrationDate|date('d/m/Y H:i') }}</td></tr>
            </table>
            <hr>
            <a href="{{ path('app_registration_index') }}" class="btn btn-secondary">Quay lại</a>
            <a href="{{ path('app_registration_edit', {id: reg.id}) }}" class="btn btn-warning">Chỉnh sửa</a>
        </div>
    </div>
</div>
{% endblock %}