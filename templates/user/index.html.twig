{% extends 'base.html.twig' %}

{% block body %}
<h2>User List</h2>

<table class="table table-striped">
    <tr>
        <th>ID</th>
        <th>Username</th>
        <th>Email</th>
        <th>Role</th>
    </tr>

    {% for u in users %}
    <tr>
        <td>{{ u.id }}</td>
        <td>{{ u.username }}</td>
        <td>{{ u.email }}</td>
        <td>{{ u.role }}</td>
    </tr>
    {% else %}
    <tr><td colspan="4">No user found</td></tr>
    {% endfor %}
</table>
{% endblock %}