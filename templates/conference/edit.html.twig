{% extends 'base.html.twig' %}

{% block title %}Cập nhật Hội nghị{% endblock %}

{% block body %}
<div class="container mt-4">
    <h2>Cập nhật Hội nghị</h2>

    <div class="card mt-3">
        <div class="card-body">
            {{ form_start(form) }}
            
                {{ form_widget(form) }}
                
                <div class="mt-3">
                    <button class="btn btn-warning" type="submit">Cập nhật dữ liệu</button>
                    <a href="{{ path('app_conference_index') }}" class="btn btn-secondary">Hủy bỏ</a>
                </div>
                
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}