{% extends 'base.html.twig' %}

{% block title %}Sửa Phòng{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning"><h2>Chỉnh sửa: {{ form.vars.value.name }}</h2></div>
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_widget(form) }}
                <div class="mt-3">
                    <button class="btn btn-primary">Cập nhật</button>
                    <a href="{{ path('app_room_index') }}" class="btn btn-secondary">Hủy</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}