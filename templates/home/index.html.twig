{% extends 'base.html.twig' %}

{% block body %}
<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="mb-2" style="color: #2c3e50; font-weight: 700;">
                <i class="fas fa-chart-line"></i> Bảng Điều Khiển Hệ Thống
            </h1>
            <p class="text-muted">Tổng hợp toàn bộ dữ liệu của hệ thống quản lý hội thảo</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <!-- Conferences Card -->
        <div class="col-md-6 col-lg-4 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-primary text-uppercase mb-1" style="font-size: 0.85rem; font-weight: 700; letter-spacing: 0.05em;">
                        Tổng Hội Thảo
                    </div>
                    <div class="h3 mb-0" style="color: #004085;">{{ totalConferences }}</div>
                </div>
                <div class="card-footer bg-transparent border-top-primary">
                    <a href="{{ path('app_conference_index') }}" class="small text-primary font-weight-bold">
                        Xem chi tiết <i class="fas fa-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Sessions Card -->
        <div class="col-md-6 col-lg-4 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-success text-uppercase mb-1" style="font-size: 0.85rem; font-weight: 700; letter-spacing: 0.05em;">
                        Tổng Phiên Họp
                    </div>
                    <div class="h3 mb-0" style="color: #155724;">{{ totalSessions }}</div>
                </div>
                <div class="card-footer bg-transparent border-top-success">
                    <a href="{{ path('app_session_index') }}" class="small text-success font-weight-bold">
                        Xem chi tiết <i class="fas fa-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Speakers Card -->
        <div class="col-md-6 col-lg-4 mb-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-info text-uppercase mb-1" style="font-size: 0.85rem; font-weight: 700; letter-spacing: 0.05em;">
                        Tổng Diễn Giả
                    </div>
                    <div class="h3 mb-0" style="color: #0c5460;">{{ totalSpeakers }}</div>
                </div>
                <div class="card-footer bg-transparent border-top-info">
                    <a href="{{ path('app_speaker_index') }}" class="small text-info font-weight-bold">
                        Xem chi tiết <i class="fas fa-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Rooms Card -->
        <div class="col-md-6 col-lg-4 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-warning text-uppercase mb-1" style="font-size: 0.85rem; font-weight: 700; letter-spacing: 0.05em;">
                        Tổng Phòng
                    </div>
                    <div class="h3 mb-0" style="color: #856404;">{{ totalRooms }}</div>
                </div>
                <div class="card-footer bg-transparent border-top-warning">
                    <a href="{{ path('app_room_index') }}" class="small text-warning font-weight-bold">
                        Xem chi tiết <i class="fas fa-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Registrations Card -->
        <div class="col-md-6 col-lg-4 mb-3">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-danger text-uppercase mb-1" style="font-size: 0.85rem; font-weight: 700; letter-spacing: 0.05em;">
                        Tổng Đăng Ký
                    </div>
                    <div class="h3 mb-0" style="color: #721c24;">{{ totalRegistrations }}</div>
                </div>
                <div class="card-footer bg-transparent border-top-danger">
                    <a href="{{ path('app_registration_index') }}" class="small text-danger font-weight-bold">
                        Xem chi tiết <i class="fas fa-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Users Card -->
        <div class="col-md-6 col-lg-4 mb-3">
            <div class="card border-left-secondary shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-secondary text-uppercase mb-1" style="font-size: 0.85rem; font-weight: 700; letter-spacing: 0.05em;">
                        Tổng Người Dùng
                    </div>
                    <div class="h3 mb-0" style="color: #383d41;">{{ totalUsers }}</div>
                </div>
                <div class="card-footer bg-transparent border-top-secondary">
                    <a href="{{ path('app_user_index') }}" class="small text-secondary font-weight-bold">
                        Xem chi tiết <i class="fas fa-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="row">
        <!-- Recent Conferences -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center" style="background-color: #f8f9fc; border-bottom: 1px solid #e3e6f0;">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-calendar-alt"></i> Hội Thảo Gần Đây
                    </h6>
                    <a href="{{ path('app_conference_index') }}" class="btn btn-sm btn-primary">Xem Tất Cả</a>
                </div>
                <div class="card-body">
                    {% if recentConferences|length > 0 %}
                        <div class="list-group">
                            {% for conference in recentConferences %}
                            <div class="list-group-item border-left-primary" style="border-left: 4px solid #004085;">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-1 font-weight-bold">{{ conference.title }}</h6>
                                        <small class="text-muted">
                                            <i class="fas fa-map-marker-alt"></i> {{ conference.location }}
                                        </small>
                                    </div>
                                </div>
                                <small class="text-muted mt-2 d-block">
                                    <i class="fas fa-clock"></i>
                                    {{ conference.startDate|date('d/m/Y') }} - {{ conference.endDate|date('d/m/Y') }}
                                </small>
                            </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> Chưa có hội thảo nào
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Recent Sessions -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center" style="background-color: #f8f9fc; border-bottom: 1px solid #e3e6f0;">
                    <h6 class="m-0 font-weight-bold text-success">
                        <i class="fas fa-tasks"></i> Phiên Họp Gần Đây
                    </h6>
                    <a href="{{ path('app_session_index') }}" class="btn btn-sm btn-success">Xem Tất Cả</a>
                </div>
                <div class="card-body">
                    {% if recentSessions|length > 0 %}
                        <div class="list-group">
                            {% for session in recentSessions %}
                            <div class="list-group-item border-left-success" style="border-left: 4px solid #155724;">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-1 font-weight-bold">{{ session.title }}</h6>
                                        <small class="text-muted">
                                            <i class="fas fa-user"></i> {{ session.speaker.name ?? 'N/A' }}
                                        </small>
                                    </div>
                                </div>
                                <small class="text-muted mt-2 d-block">
                                    <i class="fas fa-door-open"></i> {{ session.room.roomName ?? 'N/A' }} |
                                    <i class="fas fa-clock"></i> {{ session.sessionDate|date('d/m/Y') }}
                                </small>
                            </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> Chưa có phiên họp nào
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Second Row -->
    <div class="row">
        <!-- Recent Speakers -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center" style="background-color: #f8f9fc; border-bottom: 1px solid #e3e6f0;">
                    <h6 class="m-0 font-weight-bold text-info">
                        <i class="fas fa-microphone-alt"></i> Diễn Giả Gần Đây
                    </h6>
                    <a href="{{ path('app_speaker_index') }}" class="btn btn-sm btn-info">Xem Tất Cả</a>
                </div>
                <div class="card-body">
                    {% if recentSpeakers|length > 0 %}
                        <div class="list-group">
                            {% for speaker in recentSpeakers %}
                            <div class="list-group-item border-left-info" style="border-left: 4px solid #0c5460;">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-1 font-weight-bold">{{ speaker.name }}</h6>
                                        <small class="text-muted">
                                            <i class="fas fa-lightbulb"></i> Chủ đề: {{ speaker.topic }}
                                        </small>
                                    </div>
                                </div>
                                <small class="text-muted mt-2 d-block">
                                    <i class="fas fa-envelope"></i> {{ speaker.email }}
                                </small>
                            </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> Chưa có diễn giả nào
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Registration Statistics -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3" style="background-color: #f8f9fc; border-bottom: 1px solid #e3e6f0;">
                    <h6 class="m-0 font-weight-bold text-danger">
                        <i class="fas fa-chart-pie"></i> Thống Kê Đăng Ký
                    </h6>
                </div>
                <div class="card-body">
                    {% if registrationStats|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Trạng Thái</th>
                                        <th class="text-center">Số Lượng</th>
                                        <th class="text-center">Tỷ Lệ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% set totalReg = totalRegistrations %}
                                    {% for status, count in registrationStats %}
                                    {% set percentage = totalReg > 0 ? (count / totalReg * 100)|round(1) : 0 %}
                                    <tr>
                                        <td>
                                            <span class="badge 
                                                {% if status == 'Confirmed' %}
                                                    badge-success
                                                {% elseif status == 'Pending' %}
                                                    badge-warning
                                                {% elseif status == 'Cancelled' %}
                                                    badge-danger
                                                {% else %}
                                                    badge-secondary
                                                {% endif %}
                                            ">
                                                {{ status }}
                                            </span>
                                        </td>
                                        <td class="text-center font-weight-bold">{{ count }}</td>
                                        <td class="text-center">
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar {% if status == 'Confirmed' %}bg-success{% elseif status == 'Pending' %}bg-warning{% elseif status == 'Cancelled' %}bg-danger{% else %}bg-secondary{% endif %}" 
                                                     role="progressbar" 
                                                     style="width: {{ percentage }}%"
                                                     aria-valuenow="{{ percentage }}" 
                                                     aria-valuemin="0" 
                                                     aria-valuemax="100">
                                                    {{ percentage }}%
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> Chưa có dữ liệu đăng ký
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- System Info -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header py-3" style="background-color: #f8f9fc; border-bottom: 1px solid #e3e6f0;">
                    <h6 class="m-0 font-weight-bold text-secondary">
                        <i class="fas fa-info-circle"></i> Thông Tin Hệ Thống
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3 mb-3">
                            <div class="p-3">
                                <h4 class="text-primary font-weight-bold">{{ totalConferences + totalSessions + totalSpeakers }}</h4>
                                <p class="text-muted mb-0">Tổng Sự Kiện & Nội Dung</p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="p-3">
                                <h4 class="text-info font-weight-bold">{{ totalRooms }}</h4>
                                <p class="text-muted mb-0">Phòng Họp Có Sẵn</p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="p-3">
                                <h4 class="text-success font-weight-bold">{{ totalUsers }}</h4>
                                <p class="text-muted mb-0">Người Dùng Đã Đăng Ký</p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="p-3">
                                <h4 class="text-warning font-weight-bold">{{ totalRegistrations }}</h4>
                                <p class="text-muted mb-0">Lượt Đăng Ký Tham Dự</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    .border-left-primary { border-left: 4px solid #004085 !important; }
    .border-left-success { border-left: 4px solid #155724 !important; }
    .border-left-info { border-left: 4px solid #0c5460 !important; }
    .border-left-warning { border-left: 4px solid #856404 !important; }
    .border-left-danger { border-left: 4px solid #721c24 !important; }
    .border-left-secondary { border-left: 4px solid #383d41 !important; }
    .border-top-primary { border-top: 1px solid #004085 !important; }
    .border-top-success { border-top: 1px solid #155724 !important; }
    .border-top-info { border-top: 1px solid #0c5460 !important; }
    .border-top-warning { border-top: 1px solid #856404 !important; }
    .border-top-danger { border-top: 1px solid #721c24 !important; }
    .border-top-secondary { border-top: 1px solid #383d41 !important; }
    
    .card {
        border: none;
        border-radius: 0.35rem;
    }
    
    .list-group-item {
        border: 1px solid #e3e6f0;
        padding: 1rem 1.25rem;
    }
    
    .list-group-item:not(:last-child) {
        border-bottom: 1px solid #e3e6f0;
    }
</style>
{% endblock %}