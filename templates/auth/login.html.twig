{% extends 'base.html.twig' %}

{% block body %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

  .login-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8fafc; /* Light formal background */
    font-family: 'Inter', sans-serif;
    padding: 1.5rem;
  }

  .login-card {
    width: 100%;
    max-width: 400px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 40px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  }

  .login-brand {
    text-align: center;
    margin-bottom: 32px;
  }

  .brand-name {
    font-weight: 700;
    font-size: 1.25rem;
    color: #1e293b;
    letter-spacing: -0.02em;
  }

  .login-heading {
    font-weight: 600;
    font-size: 1.5rem;
    color: #0f172a;
    text-align: center;
    margin-bottom: 8px;
  }

  .login-subtext {
    font-size: 0.875rem;
    color: #64748b;
    text-align: center;
    margin-bottom: 32px;
  }

  .alert-error {
    background: #fef2f2;
    border: 1px solid #fee2e2;
    color: #b91c1c;
    border-radius: 8px;
    padding: 12px;
    font-size: 0.8125rem;
    margin-bottom: 24px;
    text-align: center;
  }

  .field-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: #334155;
    margin-bottom: 6px;
  }

  .field-input {
    width: 100%;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 0.9375rem;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
    margin-bottom: 20px;
  }

  .field-input:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    outline: none;
  }

  .btn-login {
    width: 100%;
    background: #1e293b; /* Dark formal button */
    border: none;
    border-radius: 8px;
    padding: 12px;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-login:hover {
    background: #0f172a;
  }

  .remember-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  .remember-row label {
    font-size: 0.875rem;
    color: #64748b;
  }
</style>

<div class="login-wrapper">
  <div class="login-card">
    <div class="login-brand">
      <span class="brand-name">ConferenceHub</span>
    </div>

    <h1 class="login-heading">Sign In</h1>
    <p class="login-subtext">Enter your credentials to access your account</p>

    {% if error %}
    <div class="alert-error">
      Invalid email or password. Please try again.
    </div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
      <div>
        <label class="field-label" for="email">Email Address</label>
        <input type="email" id="email" name="email" value="{{ last_username }}"
               class="field-input" placeholder="name@company.com" required autofocus>
      </div>

      <div>
        <label class="field-label" for="password">Password</label>
        <input type="password" id="password" name="password"
               class="field-input" placeholder="••••••••" required>
      </div>

      <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

      <div class="remember-row">
        <input type="checkbox" id="remember" name="_remember_me">
        <label for="remember">Remember this device</label>
      </div>

      <button type="submit" class="btn-login">Sign In</button>
    </form>
  </div>
</div>
{% endblock %}