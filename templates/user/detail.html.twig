{% extends 'base.html.twig' %}

{% block title %}Chi tiết người dùng{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-10">
            {# Nút quay lại #}
            <div class="mb-3">
                <a href="{{ path('app_user_index') }}" class="btn btn-secondary btn-sm">
                    <i class="fas fa-arrow-left"></i> Quay lại danh sách
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white p-3">
                    <h4 class="mb-0"><i class="fas fa-user-tag me-2"></i>Thông tin tài khoản: {{ user.email }}</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        {# Cột bên trái: Ảnh đại diện giả lập và Thông tin cơ bản #}
                        <div class="col-md-4 text-center border-end">
                            <div class="mb-3">
                                <i class="fas fa-user-circle fa-7x text-secondary"></i>
                            </div>
                            <h5 class="fw-bold">{{ user.email }}</h5>
                            <p class="text-muted">ID người dùng: #{{ user.id }}</p>
                            
                            <div class="mt-3">
                                {% for role in user.roles %}
                                    {% if role == 'ROLE_ADMIN' %}
                                        <span class="badge bg-danger">ADMIN</span>
                                    {% elseif role == 'ROLE_USER' %}
                                        <span class="badge bg-primary">USER</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ role }}</span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>

                        {# Cột bên phải: Các thông tin chi tiết khác #}
                        <div class="col-md-8 ps-md-5">
                            <h5 class="border-bottom pb-2 mb-3">Thông tin chi tiết</h5>
                            <table class="table table-borderless">
                                <tbody>
                                    <tr>
                                        <th style="width: 200px;"><i class="fas fa-envelope me-2 text-primary"></i> Email:</th>
                                        <td>{{ user.email }}</td>
                                    </tr>
                                    <tr>
                                        <th><i class="fas fa-shield-alt me-2 text-success"></i> Trạng thái bảo mật:</th>
                                        <td>
                                            <span class="text-success"><i class="fas fa-check-circle"></i> Đã xác thực</span>
                                        </td>
                                    </tr>
                                    {# Nếu Entity User của bạn có thêm trường như FullName hay Phone, hãy thêm ở đây #}
                                </tbody>
                            </table>

                            <h5 class="border-bottom pb-2 mt-4 mb-3">Hoạt động đăng ký</h5>
                            {% if user.registrations is defined and user.registrations|length > 0 %}
                                <div class="list-group">
                                    {% for reg in user.registrations %}
                                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>Phiên họp:</strong> {{ reg.session.title|default('N/A') }} <br>
                                                <small class="text-muted">Ngày đăng ký: {{ reg.registerDate|date('d/m/Y') }}</small>
                                            </div>
                                            <span class="badge bg-info rounded-pill">{{ reg.status }}</span>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-muted italic">Người dùng này chưa có lượt đăng ký nào.</p>
                            {% endif %}
                        </div>
                    </div>

                    <hr class="my-4">
                    
                    {# Các nút hành động #}
                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-warning">
                            <i class="fas fa-edit"></i> Chỉnh sửa
                        </a>
                        {# Nút Xóa (dùng Form để bảo mật) #}
                        <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Bạn có chắc chắn muốn xóa người dùng này?');" style="display:inline-block">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                            <button class="btn btn-danger"><i class="fas fa-trash-alt"></i> Xóa tài khoản</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}