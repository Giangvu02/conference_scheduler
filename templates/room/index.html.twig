{% extends 'base.html.twig' %}
{% block title %}Room Directory{% endblock %}
{% block body %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
  
  :root {
    --primary: #1e293b;
    --accent: #2563eb;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --bg-page: #f8fafc;
    --border: #e2e8f0;
  }

  body { background-color: var(--bg-page) !important; font-family: 'Inter', sans-serif; color: var(--text-main); }
  .container-room { max-width: 1100px; margin: 40px auto; padding: 0 24px; }
  
  .page-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px; }
  .title-group h1 { font-size: 1.875rem; font-weight: 700; letter-spacing: -0.02em; margin: 0; }
  .title-group p { color: var(--text-muted); font-size: 0.875rem; margin: 4px 0 0; }

  .btn-new {
    background: var(--accent); color: white; padding: 10px 18px; border-radius: 8px;
    font-weight: 600; text-decoration: none; font-size: 0.875rem; transition: all 0.2s;
  }
  .btn-new:hover { background: #1d4ed8; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15); }

  .table-card { background: white; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
  .room-table { width: 100%; border-collapse: collapse; }
  .room-table th {
    background: #f1f5f9; padding: 14px 20px; text-align: left;
    font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }
  .room-table td { padding: 16px 20px; border-bottom: 1px solid var(--border); font-size: 0.875rem; }
  
  .capacity-tag {
    background: #f1f5f9; color: #475569; padding: 2px 8px; border-radius: 6px; font-weight: 500; font-size: 0.8125rem;
  }

  .action-link { text-decoration: none; font-weight: 600; font-size: 0.8125rem; color: var(--accent); margin-right: 12px; }
  .action-link.delete { color: #dc2626; border: none; background: none; cursor: pointer; padding: 0; font-family: inherit; }
</style>

<div class="container-room">
    <div class="page-header">
        <div class="title-group">
            <h1>Room Inventory</h1>
            <p>Manage facility locations, capacities, and building assignments[cite: 36].</p>
        </div>
        <a href="{{ path('app_room_add') }}" class="btn-new">+ Add New Room</a>
    </div>

    <div class="table-card">
        <table class="room-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Room Name</th>
                    <th>Capacity</th>
                    <th>Building</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for room in rooms %}
                <tr>
                    <td style="color: var(--text-muted)">#{{ room.id }}</td>
                    <td style="font-weight: 600; color: var(--text-main)">{{ room.roomName }}</td>
                    <td><span class="capacity-tag">{{ room.capacity }} Pax</span></td>
                    <td>{{ room.building }}</td>
                    <td>
                        <a href="{{ path('app_room_detail', {'id': room.id}) }}" class="action-btn action-link">View</a>
                        <a href="{{ path('app_room_edit', {'id': room.id}) }}" class="action-btn action-link">Edit</a>
                        <form method="post" action="{{ path('app_room_delete', {'id': room.id}) }}" style="display: inline-block" onsubmit="return confirm('Confirm deletion of this room?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ room.id) }}">
                            <button class="action-link delete">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" style="text-align:center; padding: 48px; color: var(--text-muted)">
                        No rooms registered in the system.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}