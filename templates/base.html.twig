<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Conference Scheduler</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{
            background:#f5f5f5;
            font-family:Arial;
        }
        .navbar{
            margin-bottom:20px;
        }
        .container-box{
            background:white;
            padding:30px;
            border-radius:10px;
            box-shadow:0 0 10px rgba(0,0,0,0.1);
        }
        .nav-btn{
            margin-right:5px;
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">Conference Scheduler</a>

        <div>
            <a class="btn btn-light btn-sm nav-btn" href="/conference">Conference</a>
            <a class="btn btn-light btn-sm nav-btn" href="/session">Session</a>
            <a class="btn btn-light btn-sm nav-btn" href="/speaker">Speaker</a>
            <a class="btn btn-light btn-sm nav-btn" href="/room">Room</a>
            <a class="btn btn-light btn-sm nav-btn" href="/user">User</a>
            <a class="btn btn-light btn-sm nav-btn" href="/registration">Registration</a>
        </div>

        <div>
            {% if app.user %}
                <span class="text-white me-2">Welcome {{ app.user.email }}</span>

                {% if is_granted('ROLE_ADMIN') %}
                    <span class="badge bg-warning text-dark">ADMIN</span>
                {% endif %}

                <a href="/logout" class="btn btn-danger btn-sm ms-2">Logout</a>
            {% else %}
                <a href="/login" class="btn btn-success btn-sm">Login</a>
            {% endif %}
        </div>
    </div>
</nav>

<div class="container">
    <div class="container-box">
        {% block body %}{% endblock %}
    </div>
</div>

</body>
</html>