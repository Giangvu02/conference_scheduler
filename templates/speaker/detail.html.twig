{% extends 'base.html.twig' %}

{% block title %}Chi tiết Diễn giả{% endblock %}

{% block body %}
<div class="container mt-4">
    <h2>Chi tiết Diễn giả: {{ speaker.name }}</h2>

    <table class="table table-bordered mt-3">
        <tbody>
            <tr><th style="width: 200px;">ID</th><td>{{ speaker.id }}</td></tr>
            <tr><th>Tên</th><td>{{ speaker.name }}</td></tr>
            <tr><th>Email</th><td>{{ speaker.email }}</td></tr>
            <tr><th>Chủ đề</th><td>{{ speaker.topic }}</td></tr>
            <tr><th>Tiểu sử</th><td>{{ speaker.biography|nl2br }}</td></tr>
        </tbody>
    </table>

    <div class="mt-3">
        <a href="{{ path('app_speaker_index') }}" class="btn btn-secondary">Quay lại</a>
    </div>
</div>
{% endblock %}