<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Conference Scheduler</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{
            background:#f5f5f5;
        }
        .navbar{
            margin-bottom:20px;
        }
        .container-box{
            background:white;
            padding:30px;
            border-radius:10px;
            box-shadow:0 0 10px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">Conference Scheduler</a>
        <div>
            <a class="btn btn-light btn-sm" href="/conference">Conference</a>
            <a class="btn btn-light btn-sm" href="/session">Session</a>
            <a class="btn btn-light btn-sm" href="/speaker">Speaker</a>
            <a class="btn btn-light btn-sm" href="/room">Room</a>
            <a class="btn btn-light btn-sm" href="/user">User</a>
            <a class="btn btn-light btn-sm" href="/registration">Registration</a>
        </div>
    </div>
</nav>

<div class="container">
    <div class="container-box">
        {% block body %}{% endblock %}
    </div>
</div>

</body>
</html>