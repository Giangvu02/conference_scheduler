<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Conference Scheduler{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    {# Thư viện thông báo SweetAlert2 #}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        body {
            background: #f5f5f5;
            font-family: Arial, sans-serif;
        }
        .navbar {
            margin-bottom: 20px;
        }
        .container-box {
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        .nav-btn {
            margin-right: 5px;
            font-weight: 500;
        }
        /* Style cho lỗi nhập liệu */
        .is-invalid { border-color: #dc3545 !important; }
        .invalid-feedback { display: block; color: #dc3545; font-size: 0.85em; margin-top: 5px; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_room_index') }}">Conference Scheduler</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <div class="navbar-nav me-auto">
                {# Các nút bấm dạng btn-light giống hệt giao diện cũ #}
                <a class="btn btn-light btn-sm nav-btn" href="/conference">Conference</a>
                <a class="btn btn-light btn-sm nav-btn" href="/session">Session</a>
                <a class="btn btn-light btn-sm nav-btn" href="/speaker">Speaker</a>
                <a class="btn btn-light btn-sm nav-btn" href="{{ path('app_room_index') }}">Room</a>
                <a class="btn btn-light btn-sm nav-btn" href="/user">User</a>
                <a class="btn btn-light btn-sm nav-btn" href="{{ path('app_registration_index') }}">Registration</a>
            </div>

            <div class="d-flex align-items-center">
                {% if app.user %}
                    <span class="text-white me-3">
                        Welcome <strong>{{ app.user.email }}</strong>
                        {% if is_granted('ROLE_ADMIN') %}
                            <span class="badge bg-warning text-dark ms-1">ADMIN</span>
                        {% endif %}
                    </span>
                    <a href="{{ path('app_logout') }}" class="btn btn-danger btn-sm">Logout</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-success btn-sm">Login</a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

<div class="container">
    <div class="container-box">
        {% block body %}{% endblock %}
    </div>
</div>

{# Bootstrap JS để các nút menu hoạt động #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // 1. Pop-up thông báo thành công/lỗi từ Controller
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            Swal.fire({
                icon: '{{ label == "success" ? "success" : "error" }}',
                title: '{{ label == "success" ? "Thành công!" : "Thông báo" }}',
                text: '{{ message }}',
                confirmButtonColor: '#3085d6',
                timer: 3500
            });
        {% endfor %}
    {% endfor %}

    // 2. Pop-up khi có lỗi Validate Form
    document.addEventListener('DOMContentLoaded', function() {
        const hasErrors = document.querySelector('.is-invalid, .invalid-feedback, .alert-danger');
        if (hasErrors) {
            Swal.fire({
                icon: 'error',
                title: 'Lỗi nhập liệu',
                text: 'Vui lòng kiểm tra lại các thông tin màu đỏ trong form!',
                confirmButtonColor: '#d33'
            });
        }
    });
</script>

</body>
</html>