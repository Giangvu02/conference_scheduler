{% extends 'base.html.twig' %}

{% block title %}Đăng ký mới{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0"><i class="fas fa-plus-circle"></i> Tạo đơn đăng ký mới</h3>
                </div>
                <div class="card-body p-4">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.user, 'Chọn người dùng tham gia') }}
                            {{ form_widget(form.user, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.user) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.session, 'Chọn phiên họp (Session)') }}
                            {{ form_widget(form.session, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.session) }}
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="{{ path('app_registration_index') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-success px-4">
                                Xác nhận đăng ký
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}